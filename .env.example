# Cloudbeds Dashboard — environment variables
# Copy to .env.local for local dev, and set the same vars in Vercel (Production
# + Preview). NEVER commit real values — .env*.local is gitignored.
#
# ONE SCOPED KEY PER PROPERTY. Each key starts with cbat_ and resolves its own
# property (no propertyID passed). Naming: CLOUDBEDS_API_KEY_<CODE>. Fill in the
# keys you have; leave the rest blank — unconfigured properties show "Awaiting
# key" on the dashboard until a key is added and you redeploy.
#
# Server-side only — NO NEXT_PUBLIC_ prefix on any of these.

# DP — Davenport        (Polk,      business ID 44199, API propertyID 318197)
CLOUDBEDS_API_KEY_DP=

# LL — Lakeland         (Polk,      business ID 4645)
CLOUDBEDS_API_KEY_LL=

# KE — Kissimmee East   (Osceola,   business ID 2295)
CLOUDBEDS_API_KEY_KE=

# KW — Kissimmee West   (Osceola,   business ID 5399)
CLOUDBEDS_API_KEY_KW=

# JW — Jacksonville West (Duval,    business ID 6802)
CLOUDBEDS_API_KEY_JW=

# JN — Jacksonville North (Duval,   business ID 812)
CLOUDBEDS_API_KEY_JN=

# SA — St. Augustine    (St. Johns, business ID 2535)
CLOUDBEDS_API_KEY_SA=

# OR — Orlando OBT      (Orange,    business ID 8700)
CLOUDBEDS_API_KEY_OR=

# --- Access gate (PIN) ---
# PINs are NOT env vars. Every login PIN (base / exec / crystal / monica / bea /
# ops / elise) lives ONLY in the Neon `dashboard_pins` table — Neon is the single
# source of truth, edited self-service via /api/change-pin (lib/pins.ts). There is
# NO env-var fallback: a level with no row simply cannot log in. Seed with
# `node scripts/seed-pins.mjs`; check which levels can log in with
# `node scripts/check-pins.mjs`. The home `/` is GATED at the `base` level
# (changed 07/08/26) — it is no longer public.
#
# AUTH_SECRET (optional): HMAC secret for the signed level cookie. Falls back to
# DATABASE_URL when unset, so the gate is never accidentally open. Set it to
# decouple cookie signing from the DB connection string (one re-login on change).
AUTH_SECRET=

# --- Persistence (server-only) ---
# Neon Postgres pooled connection string from the Neon console / Vercel Storage
# tab. Required for /api/submit (/test intake form) and /api/feedback (exec
# feedback). One `submissions` table; no guest PII. Sensitive — never committed,
# and cannot be `vercel env pull`ed (set it directly in .env.local and Vercel).
DATABASE_URL=postgresql://...

# --- EliseAI Snowflake data share (server-only; /ops §2 Leasing funnel) ---
# Reader Account credentials for the EliseAI data share. Used ONLY by the nightly
# aggregate sync (scripts/elise-sync.mjs / /api/cron/elise-sync) which pulls
# PII-FREE GROUP-BY rollups into Neon. No name/email/phone column is ever read.
# Server-side only — NO NEXT_PUBLIC_ prefix. Password rotates on Elise's expiry
# schedule — update here + in Vercel when it changes (or move to key-pair auth).
SNOWFLAKE_ACCOUNT=ihpsnqz-rise8_reader
SNOWFLAKE_USER=rise8_reader
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=RISE8_WAREHOUSE
SNOWFLAKE_DATABASE=RISE8_DATA
SNOWFLAKE_SCHEMA=DA
SNOWFLAKE_ROLE=SYSADMIN

# CRON_SECRET (recommended): Vercel Cron sends `Authorization: Bearer <value>`
# to /api/cron/elise-sync. When set, the route rejects requests without it.
CRON_SECRET=

# --- Smartsheet (server-only, READ-ONLY) ---
# Raw API access token: Smartsheet → Personal Settings → API Access → Generate.
# NOT the claude.ai MCP OAuth connector — that is interactive and unusable from
# the deployed server. Without this token three sections degrade to an error
# message and nothing else breaks:
#   /ops  §Evictions            (sheet 4398121124581252 + closed 1160578736646020)
#   /ops  §One-star reviews     (sheet 4932316188436356)
#   /rob  §6 Contractor schedule (sheet 1391340150542212)
SMARTSHEET_API_TOKEN=
# Optional overrides — each defaults to the ID above in code.
SMARTSHEET_EVICTIONS_SHEET_ID=
SMARTSHEET_CLOSED_SHEET_ID=
# The contractor schedule sheet (/rob §6). ONE long-lived sheet whose NAME
# auto-changes for each new schedule — "same sheet" (Kyle 08/05/26) — so the
# default ID in lib/contractor-schedule.ts is stable and needs no weekly
# maintenance. Set this only if the sheet is ever genuinely replaced.
SMARTSHEET_CONTRACTOR_SHEET_ID=

# --- Daily revenue report (Teams delivery) ---
# Teams delivery for the daily revenue report (Power Automate HTTP-trigger flow).
# Secret (contains a sig= token). Server-only. The POST body is a full Adaptive Card.
TEAMS_FLOW_URL=
# Optional: absolute base URL for the card's buttons (defaults to the prod domain).
PUBLIC_BASE_URL=

# --- Daily due-out room walk list (Teams delivery, 9:00 AM ET) ---
# A DIFFERENT Power Automate flow from TEAMS_FLOW_URL — the "Daily Due Out or
# Departures" flow. Secret (contains a sig= token). Server-only.
# Unset = /api/cron/due-outs posts nothing and reports `unconfigured`; it never
# silently succeeds.
TEAMS_FLOW_URL_DUEOUT=
# Attach the walk-list .xlsx to the post. Flip to 1 ONLY after the flow reads
# triggerBody()?['card'] — see docs/TEAMS-ATTACHMENTS.md. Deliberately separate
# from TEAMS_FLOW_ATTACHMENTS so the two flows can be edited independently.
DUEOUT_ATTACH_XLSX=
# Send the `ddf` block (sheet name + headers + rows) so the flow's Excel Online
# steps can create the MM.DD sheet in DDF Refund <year>.xlsx. Flip to 1 only
# once those steps exist AND they ADD a sheet rather than overwrite one — the
# team edits those rows in place all day and their edits cannot be rebuilt.
DDF_SEED_ENABLED=
# Fill the workbook's Name column. OFF by default: no code outside /bea §3
# emits a guest name (CLAUDE.md §5 rule 2). Turning this on is a decision.
DDF_INCLUDE_GUEST_NAMES=
# Share link to the DDF Refund workbook, rendered as a button on the card.
# Contains an ?e= share token — treat as sensitive, server-only.
DDF_WORKBOOK_URL=

# --- Knowledgebase assistant (the /kb chatbot) -------------------------------
# Anthropic API key, from https://console.anthropic.com → Settings → API keys.
# Server-only — NEVER prefix with NEXT_PUBLIC_ (CLAUDE.md §5 rule 1). Starts
# "sk-ant-".
#
# Unset = the floating chat widget answers 503 with an honest "not configured"
# message and nothing else in the app changes. The MCP knowledgebase tools
# (search_kb / get_kb_document / list_kb_documents) do NOT need this key at all
# — they hand the corpus to whichever model the caller is already paying for.
#
# Cost: the whole corpus (~18K tokens) goes into a CACHED system prompt on a
# 1-hour TTL, so a query costs well under a cent. Budget $15–75/month at Haiku
# 4.5. The model is one string, KB_ASK_MODEL in lib/kb-ask.ts — gated on
# `npx tsx scripts/kb-eval.mts` passing before rollout.
ANTHROPIC_API_KEY=
# LAUNCH SWITCH for the floating knowledgebase chat widget. DEFAULT OFF.
# Only the exact string "1" turns it on — anything else leaves it hidden, so a
# fat-fingered value fails closed rather than launching to 40 staff.
#
# Gates BOTH the widget and /api/kb/ask together. Hiding the button while the
# endpoint still answered would still call the model and still bill for anyone
# who knew the path — that is not "off".
#
# Does NOT gate the MCP knowledgebase tools (search_kb / get_kb_document /
# list_kb_documents): those cost us nothing, since the caller's own model does
# the work, and they sit behind per-person /connectors tokens rather than the
# shared MAIN pin.
KB_CHAT_ENABLED=
