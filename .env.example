# Cloudbeds Dashboard — environment variables
# Copy to .env.local for local dev, and set the same vars in Vercel (Production
# + Preview). NEVER commit real values — .env*.local is gitignored.
#
# ONE SCOPED KEY PER PROPERTY. Each key starts with cbat_ and resolves its own
# property (no propertyID passed). Naming: CLOUDBEDS_API_KEY_<CODE>. Fill in the
# keys you have; leave the rest blank — unconfigured properties show "Awaiting
# key" on the dashboard until a key is added and you redeploy.
#
# Server-side only — NO NEXT_PUBLIC_ prefix on any of these.

# DP — Davenport        (Polk,      business ID 44199, API propertyID 318197)
CLOUDBEDS_API_KEY_DP=

# LL — Lakeland         (Polk,      business ID 4645)
CLOUDBEDS_API_KEY_LL=

# KE — Kissimmee East   (Osceola,   business ID 2295)
CLOUDBEDS_API_KEY_KE=

# KW — Kissimmee West   (Osceola,   business ID 5399)
CLOUDBEDS_API_KEY_KW=

# JW — Jacksonville West (Duval,    business ID 6802)
CLOUDBEDS_API_KEY_JW=

# JN — Jacksonville North (Duval,   business ID 812)
CLOUDBEDS_API_KEY_JN=

# SA — St. Augustine    (St. Johns, business ID 2535)
CLOUDBEDS_API_KEY_SA=

# OR — Orlando OBT      (Orange,    business ID 8700)
CLOUDBEDS_API_KEY_OR=

# --- Access gate (PIN) ---
# PINs are NOT env vars. Every login PIN (exec / crystal / monica / bea / ops)
# lives ONLY in the Neon `dashboard_pins` table — Neon is the single source of
# truth, edited self-service via /api/change-pin (lib/pins.ts). Seed/verify rows
# with `node scripts/seed-pins.mjs`. The home `/` is public (no PIN).
#
# AUTH_SECRET (optional): HMAC secret for the signed level cookie. Falls back to
# DATABASE_URL when unset, so the gate is never accidentally open. Set it to
# decouple cookie signing from the DB connection string (one re-login on change).
AUTH_SECRET=

# --- Persistence (server-only) ---
# Neon Postgres pooled connection string from the Neon console / Vercel Storage
# tab. Required for /api/submit (/test intake form) and /api/feedback (exec
# feedback). One `submissions` table; no guest PII. Sensitive — never committed,
# and cannot be `vercel env pull`ed (set it directly in .env.local and Vercel).
DATABASE_URL=postgresql://...

# --- EliseAI Snowflake data share (server-only; /ops §2 Leasing funnel) ---
# Reader Account credentials for the EliseAI data share. Used ONLY by the nightly
# aggregate sync (scripts/elise-sync.mjs / /api/cron/elise-sync) which pulls
# PII-FREE GROUP-BY rollups into Neon. No name/email/phone column is ever read.
# Server-side only — NO NEXT_PUBLIC_ prefix. Password rotates on Elise's expiry
# schedule — update here + in Vercel when it changes (or move to key-pair auth).
SNOWFLAKE_ACCOUNT=ihpsnqz-rise8_reader
SNOWFLAKE_USER=rise8_reader
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=RISE8_WAREHOUSE
SNOWFLAKE_DATABASE=RISE8_DATA
SNOWFLAKE_SCHEMA=DA
SNOWFLAKE_ROLE=SYSADMIN

# CRON_SECRET (recommended): Vercel Cron sends `Authorization: Bearer <value>`
# to /api/cron/elise-sync. When set, the route rejects requests without it.
CRON_SECRET=
